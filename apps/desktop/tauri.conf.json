{
  "$schema": "https://raw.githubusercontent.com/tauri-apps/tauri/dev/crates/tauri-cli/config.schema.json",
  "productName": "Finished",
  "version": "1.0.0",
  "identifier": "com.finished.app",
  "build": {
    "frontendDist": "../web/dist",
    "devUrl": "http://localhost:5173"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Finished — Local-First Task Manager",
        "width": 1200,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true
      }
    ],
    "trayIcon": {
      "iconPath": "icons/tray-icon.png",
      "tooltip": "Finished Task Manager (Global Shortcut: Ctrl+Shift+Space)"
    },
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "powersync": {
      "databasePath": "finished_desktop.db"
    },
    "globalShortcut": {
      "shortcuts": [
        {
          "name": "quick_add",
          "shortcut": "CommandOrControl+Shift+Space",
          "action": "open_quick_add_window"
        }
      ]
    }
  }
}
